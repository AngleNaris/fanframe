{
  "name": "fanframe",
  "version": "1.11.1",
  "description": "FanFrame (繁界, “Fanxing’s realm”) lightly polishes the DeepSeek Harness Desktop UI for a more comfortable everyday experience.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./chat-preview-host": "./src/chat-preview/host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/PDFJS-LICENSE",
    "lib/MARKDOWN-IT-LICENSE",
    "src/chat-preview/host.js",
    "src/chat-preview/read-attachment.js",
    "src/chat-preview/limits.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/chat-preview/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "markdown-it": "14.2.0",
    "pdfjs-dist": "5.7.284"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.4.0-0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ui",
    "theme",
    "fanframe"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngleNaris/fanframe.git"
  },
  "homepage": "https://github.com/AngleNaris/fanframe#readme",
  "bugs": {
    "url": "https://github.com/AngleNaris/fanframe/issues"
  },
  "license": "MIT"
}
